# Salin jadi `.env` kalau mau mengubah default. Semua opsional.
#   copy .env.example .env   (Windows)  /  cp .env.example .env  (bash)

# --- Server (sengaja localhost saja; jangan diarahkan ke 0.0.0.0) ---
HOST=127.0.0.1
PORT=8000

# --- Lokasi data lokal ---
# DATA_DIR=D:\data-playlist
# DB_PATH=D:\data-playlist\playlist.db

# --- Browser untuk window stream (kosongkan = auto-detect Chrome/Edge/Brave) ---
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Privasi: hapus profil browser stream (cookie/history) saat stream distop ---
WIPE_PROFILE_ON_STOP=1

# --- Opsional: satu proxy/VPN untuk SEMUA window stream ---
# Browser harianmu tidak ikut lewat sini. Contoh:
# PROXY_SERVER=socks5://127.0.0.1:1080
# PROXY_SERVER=http://127.0.0.1:8888
